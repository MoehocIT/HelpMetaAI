      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "if (!$json.title || !$json.description) throw new Error('Ticket title and description are required');\nreturn [{ json: { ...$json, validation: { valid: true, checkedAt: new Date().toISOString() } } }];"
      },
      "position": [
        480,
        0
      ]
    },
    {
      "id": "3214b6b8-42e3-4f7c-93bc-966a4156ecdd",
      "name": "Normalize Ticket Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, ticketId: String($json.ticketId ?? ('TCK-' + Date.now())), status: String($json.status ?? 'Open'), workflowTrace: Array.isArray($json.workflowTrace) ? $json.workflowTrace : [], stepTrace: Array.isArray($json.stepTrace) ? $json.stepTrace : [] } }];"
      },
      "position": [
        720,
        0
      ]
    },
    {
      "id": "9bf3fb1e-10cc-4562-a8b8-dcfaacaeac82",
      "name": "Set Audit Event Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, auditEventType: 'ticket.processed' } }];"
      },
      "position": [
        960,
        0
      ]
    },
    {
      "id": "9862fb66-2866-43ec-98ea-68fec5c82aa3",
      "name": "Capture Audit Timestamp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, auditTimestamp: new Date().toISOString() } }];"
      },
      "position": [
        1200,
        0
      ]
    },
    {
      "id": "f206b9cc-e911-4955-be75-b363e67b2765",
      "name": "Capture Ticket Identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, auditTicket: { ticketId: $json.ticketId, status: $json.status, category: $json.category, priority: $json.priority } } }];"
      },
      "position": [
        1440,
        0
      ]
    },
    {
      "id": "fcde1962-fa0d-4398-85c3-08a52b73c32b",
      "name": "Redact Sensitive Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const redacted={...$json}; for(const key of Object.keys(redacted)) if(/password|secret|token|otp/i.test(key)) redacted[key]='[REDACTED]'; return [{ json: redacted }];"
      },
      "position": [
        1680,
        0
      ]
    },
    {
      "id": "d10b6bea-bffc-4a00-9a98-648e837d51ec",
      "name": "Build Audit Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, auditLog: { event: $json.auditEventType, ticketId: $json.ticketId, processedAt: $json.auditTimestamp, workflowTrace: $json.workflowTrace, status: $json.status } } }];"
      },
      "position": [
        1920,
        0
      ]
    },

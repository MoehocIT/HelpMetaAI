      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const payload = $json.body && typeof $json.body === 'object' ? { ...$json.body, ...$json } : $json;\nreturn [{ json: { ...payload, title: String(payload.title ?? '').trim(), description: String(payload.description ?? '').trim() } }];"
      },
      "position": [
        240,
        0
      ]
    },
    {
      "id": "438528e7-dd42-4586-a24e-f1ad09daa86f",
      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "if (!$json.title || !$json.description) throw new Error('Ticket title and description are required');\nreturn [{ json: { ...$json, validation: { valid: true, checkedAt: new Date().toISOString() } } }];"
      },
      "position": [
        480,
        0
      ]
    },
    {
      "id": "7d35b5c6-be3f-43a6-b46f-3b2eaf970c50",
      "name": "Normalize Ticket Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, ticketId: String($json.ticketId ?? ('TCK-' + Date.now())), status: String($json.status ?? 'Open'), workflowTrace: Array.isArray($json.workflowTrace) ? $json.workflowTrace : [], stepTrace: Array.isArray($json.stepTrace) ? $json.stepTrace : [] } }];"
      },
      "position": [
        720,
        0
      ]
    },
    {
      "id": "5f2b29d0-c071-44b4-84ac-3ef01493d2f4",
      "name": "Check High Priority",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, highPriority: $json.priority==='High' } }];"
      },
      "position": [
        960,
        0
      ]
    },
    {
      "id": "5b856fd0-18fc-43ef-a4f7-c98922e00b45",
      "name": "Build Alert Severity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const severity=$json.priority==='High'?'critical':$json.priority==='Medium'?'normal':'low'; return [{ json: { ...$json, alertSeverity: severity } }];"
      },
      "position": [
        1200,
        0
      ]
    },
    {
      "id": "a8251309-4000-4209-970d-8e6be6d459fe",
      "name": "Build Alert Recipients",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const recipients=$json.priority==='High'?['IT on-call','Support lead']:['Support queue']; return [{ json: { ...$json, alertRecipients: recipients } }];"
      },
      "position": [
        1440,
        0
      ]
    },
    {
      "id": "654fdce3-b2e1-45b0-b78f-ee1772183e67",
      "name": "Build Alert Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, alertMessage: 'Ticket ' + $json.ticketId + ' - ' + ($json.priority||'Unrated') + ' - ' + $json.title } }];"
      },
      "position": [
        1680,
        0
      ]
    },
    {
      "id": "eb8f3597-1e93-404f-8a94-15b16ff89361",
      "name": "Prepare Alert Delivery Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, alert: { required: $json.highPriority, sent: false, severity: $json.alertSeverity, recipients: $json.alertRecipients, message: $json.alertMessage, note: 'Configure an email/chat node and credentials to deliver alerts.' } } }];"
      },
      "position": [
        1920,
        0
      ]
    },
    {
      "id": "f16800ad-577d-48c4-a58c-a3c928278824",
      "name": "Append Workflow Trace",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const workflowId = $workflow.name.match(/^WF\\d+/)?.[0] ?? 'WF';\nreturn [{ json: { ...$json, workflowTrace: [...new Set([...($json.workflowTrace ?? []), workflowId])], stepTrace: [...($json.stepTrace ?? []), 'workflow-complete'] } }];"
      },
      "position": [
        2160,
        0
      ]
    },
    {
      "id": "f87e8b09-2bad-4fc7-8659-1f5dc34e05b7",
      "name": "Build Result Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, workflowResult: { workflow: $workflow.name, ticketId: $json.ticketId, processedAt: new Date().toISOString(), success: true } } }];"
      },
      "position": [
        2400,

        0
      ]
    },
    {
      "id": "dce967a5-f81b-461d-8013-6e72853eb5d8",
      "name": "Set Intake Source",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, source: $json.source || 'helpdeskai' } }];"
      },
      "position": [
        1440,
        0
      ]
    },
    {
      "id": "944d47b6-462a-4974-9c5a-85f5489a0f20",
      "name": "Set Initial Ticket Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, status: $json.status || 'Open' } }];"
      },
      "position": [
        1680,
        0
      ]
    },
    {
      "id": "14b7bad7-7ca7-4efd-9c3f-65cb2f464ed6",
      "name": "Create Intake Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, intake: { accepted: true, titleLength: $json.title.length, descriptionLength: $json.description.length } } }];"
      },

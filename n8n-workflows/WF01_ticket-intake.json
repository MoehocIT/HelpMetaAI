      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, ticketId: String($json.ticketId ?? ('TCK-' + Date.now())), status: String($json.status ?? 'Open'), workflowTrace: Array.isArray($json.workflowTrace) ? $json.workflowTrace : [], stepTrace: Array.isArray($json.stepTrace) ? $json.stepTrace : [] } }];"
      },
      "position": [
        720,
        0
      ]
    },
    {
      "id": "940a020a-1f12-46ae-bae1-20d7b437bb28",
      "name": "Generate Ticket Identifier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, ticketId: String($json.ticketId || ('TCK-' + Date.now())) } }];"
      },
      "position": [
        960,
        0
      ]
    },
    {
      "id": "d84e54ae-2a70-420b-8858-bc911f42f2f6",
      "name": "Record Intake Timestamp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$json, createdAt: $json.createdAt || new Date().toISOString() } }];"
      },
